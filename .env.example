PORT=3000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# ---- MySQL (Laragon default: root, empty password) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lab06_saas
DB_POOL_SIZE=10
DB_SSL=false

# ---- Kafka (Aiven free tier, or local Redpanda via docker-compose) ----
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=tenant.orders
KAFKA_PARTITIONS=2
KAFKA_GROUP_ID=order-processors
KAFKA_SSL=false
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=scram-sha-256
# Aiven login uses 3 certificate files (download from the service page). Local PC: use PATH variables.
KAFKA_SSL_CA_PATH=
KAFKA_SSL_CERT_PATH=
KAFKA_SSL_KEY_PATH=
# Hosting (Render): paste the file text instead, with line breaks written as \n
KAFKA_SSL_CA=
KAFKA_SSL_CERT=
KAFKA_SSL_KEY=

# true = consumer runs inside the API process (handy for free hosting with one service)
RUN_CONSUMER_IN_API=false

# ---- Serverless invoice worker (Vercel) ----
INVOICE_FUNCTION_URL=
INVOICE_SECRET=lab06-invoice-secret

# ---- Seeding / benchmark ----
SEED_ORDERS_PER_TENANT=50000
ALLOW_BENCHMARK_DDL=true
